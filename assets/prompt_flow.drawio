        <!-- Internal distillation edges -->
        <mxCell id="e_dist_check" edge="1" parent="distill_group" source="distiller" target="check_exist" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;" />
        <mxCell id="e_check_reinf" edge="1" parent="distill_group" source="check_exist" target="reinforce" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=1.5;fontColor=#6ee7b7;fontSize=9;labelBackgroundColor=none;" value="Reinforce" />
        <mxCell id="e_check_super" edge="1" parent="distill_group" source="check_exist" target="supersede" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=1.5;fontColor=#fda4af;fontSize=9;labelBackgroundColor=none;" value="Contradict" />
        <mxCell id="e_check_novel" edge="1" parent="distill_group" source="check_exist" target="save_pillar" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818cf8;strokeWidth=1.5;exitX=1;exitY=0.25;entryX=0;entryY=0.5;fontColor=#e0e7ff;fontSize=9;labelBackgroundColor=none;" value="Novel" />
        <mxCell id="e_save_moc" edge="1" parent="distill_group" source="save_pillar" target="link_moc" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#a78bfa;strokeWidth=1.5;" />

        <!-- Edge: Response -> Distiller -->
        <mxCell id="e_resp_dist" edge="1" parent="1" source="response" target="distiller" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontColor=#7dd3fc;fontSize=10;labelBackgroundColor=none;" value="Turn Distillation" />

        <!-- Edge: Flag Memory -> Distiller -->
        <mxCell id="e_flag_dist" edge="1" parent="1" source="flag_mem" target="distiller" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#a78bfa;strokeWidth=1.5;dashed=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;fontColor=#c4b5fd;fontSize=10;labelBackgroundColor=none;" value="Memory Flag">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="410" y="840" />
              <mxPoint x="260" y="840" />
              <mxPoint x="260" y="933" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Feedback Loop: Distilled Notes -> Memory Recall (dashed) -->
        <mxCell id="e_feedback_loop" edge="1" parent="1" source="link_moc" target="scanner" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;dashed=1;edgeStyle=orthogonalEdgeStyle;fontColor=#fda4af;fontSize=10;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" value="Crystallized → Next Prompt Recall">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="-20" as="offset" />
            <Array as="points">
              <mxPoint x="1330" y="996" />
              <mxPoint x="1330" y="215" />
            </Array>
