        <mxCell id="e_s6_s7" edge="1" parent="1" source="s6" target="s7" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8b5cf6;strokeWidth=2;" />

        <mxCell id="e_s4_s8" edge="1" parent="1" source="s4" target="s8" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" />
        <mxCell id="e_s5_s8" edge="1" parent="1" source="s5" target="s8" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" />
        <mxCell id="e_s7_s8" edge="1" parent="1" source="s7" target="s8" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" />

        <mxCell id="e_s8_engine" edge="1" parent="1" source="s8" target="engine" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#14b8a6;strokeWidth=2;" />
